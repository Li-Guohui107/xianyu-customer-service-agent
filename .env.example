# 复制为 .env 后在本机填写。不要把 .env 提交到 Git。
# 下面的值留空；代码里没有默认密钥。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_PATH=data/agent.db

# 买家问价格、优惠或出价时，草稿不报金额，只给出这个微信号。
WECHAT_ID=

# 浏览器用户目录只放在本机。不要把 Cookie 或该目录提交到 Git。
# 当前版本即使填写了，也不会打开闲鱼页面，也不会自动发送消息。
XIANYU_BROWSER_USER_DATA=
