# 复制为 .env 后在本机填写。不要把 .env 提交到 Git。
# 下面的值留空；代码里没有默认密钥。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_PATH=data/agent.db

# 买家问价格、优惠或出价时，草稿不报金额，只给出这个微信号。
WECHAT_ID=

# 登录目录在本机的 browser-profile/。不要把 Cookie 或该目录提交到 Git。
# 自动回复使用系统 Chrome 的调试端口，不读取下面这个变量。
XIANYU_BROWSER_USER_DATA=
